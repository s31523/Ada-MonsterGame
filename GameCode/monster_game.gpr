project Monster_Game is

   for Source_Dirs use ("src/General_Utlities/", "src/Game_Pieces/", "src");
   for Object_Dir use "obj";
   for Main use ("monster_game.adb");

   package Builder is
      for Switches ("ada") use ("-g");
   end Builder;

   package Compiler is
      for Switches ("ada") use ("-g", "-gnat12");
   end Compiler;

   package Binder is
      for Switches ("ada") use ("-E");
   end Binder;

   package Linker is
      for Switches ("ada") use ("-g");
   end Linker;

   package Documentation is
   end Documentation;

end Monster_Game;

